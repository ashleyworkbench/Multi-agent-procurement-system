# =============================================================
# ENVIRONMENT VARIABLES - EXAMPLE FILE
# Multi-Agent Procurement System
# =============================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update passwords and API keys for production
# 3. Never commit .env to version control
#
# =============================================================

# -------------------------------------------------------
# PostgreSQL Configuration
# -------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=procurement_admin
POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# -------------------------------------------------------
# MySQL Configuration
# -------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=YOUR_SECURE_ROOT_PASSWORD_HERE
MYSQL_USER=procurement_admin
MYSQL_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# -------------------------------------------------------
# API Keys (Generate unique keys for production)
# Use: openssl rand -hex 32
# -------------------------------------------------------
CONSTRUCTION_KEY=CONST-a8f3d2e1-4b9c-4d7f-89ab-cdef01234567
PHARMA_KEY=PHARM-b7e2c1d0-3a8b-4c6e-78ab-bcde90123456
MANUFACTURING_KEY=MANUF-c6d1b0e9-2978-4b5d-67ab-abcd89012345
ELECTRONICS_KEY=ELEC-d5c0a9f8-1867-4a4c-56ab-9abc78901234
OCR_SERVICE_KEY=OCR-e4b9f8e7-0756-4938-45ab-8abc67890123
PROCUREMENT_KEY=PROC-f3a8e7d6-9645-4827-34ab-7abc56789012
GATEWAY_KEY=GATEWAY-master-key-2024

# -------------------------------------------------------
# Redis Configuration
# -------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
CACHE_TTL_SECONDS=600

# -------------------------------------------------------
# Kafka Configuration
# -------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_OCR_REQUESTS=ocr-request-topic
KAFKA_TOPIC_INVENTORY_EVAL=inventory-evaluation-topic
KAFKA_TOPIC_VENDOR_RECOMMEND=vendor-recommendation-topic
KAFKA_TOPIC_PURCHASE_ORDERS=purchase-order-topic

# -------------------------------------------------------
# Service URLs (Docker internal network)
# -------------------------------------------------------
OCR_SERVICE_URL=http://ocr-service:8001
INTEGRATION_GATEWAY_URL=http://api-gateway:8000
INVENTORY_SERVICE_URL=http://inventory-service:8002
VENDOR_SERVICE_URL=http://vendor-service:8003
PROCUREMENT_SERVICE_URL=http://procurement-service:8004

# -------------------------------------------------------
# Application Settings
# -------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# -------------------------------------------------------
# Agent 1 — LLM API Keys (Optional - for OCR enhancement)
# Get from: https://console.groq.com/ and https://makersuite.google.com/
# -------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------
# MinIO Configuration (Document Storage)
# -------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_HERE
MINIO_BUCKET=procurement-documents
MINIO_SECURE=false

# -------------------------------------------------------
# Agent 1 Database URL
# -------------------------------------------------------
AGENT1_DATABASE_URL=postgresql://procurement_admin:YOUR_PASSWORD@postgres:5432/ocr_procurement_db

# =============================================================
# END OF CONFIGURATION
# =============================================================
